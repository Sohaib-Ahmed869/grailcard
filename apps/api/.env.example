# Copy to .env and fill in real keys. NEVER commit .env itself.

# Ximilar card-grader v2 (trained condition grading + sports ID) — app.ximilar.com
XIMILAR_API_KEY=

# Google Gemini (AI vision identification fallback) — aistudio.google.com
GEMINI_API_KEY=

# JustTCG (prices for 18 TCGs) — justtcg.com
JUSTTCG_API_KEY=

# apitcg (Union Arena / Dragon Ball / Gundam / Riftbound catalogs) — apitcg.com
APITCG_API_KEY=

# PokemonPriceTracker (PSA graded + raw prices) — pokemonpricetracker.com
PPT_API_KEY=

# CardGrader.AI agent (graded-price backup via their market module) — cardgrader.ai
CARDGRADER_API_KEY=

# Optional overrides
# GRADING_COST=25
# VISION_URL=http://localhost:8100

# Grounded web pricing (last-resort valuation) reuses GEMINI_API_KEY above:
# Gemini + Google Search reads public price pages and every figure it returns
# is re-fetched and checked against the page it cites. Set WEB_PRICING=0 to
# turn the lookup off entirely (it costs a call and a few seconds per new card).
# WEB_PRICING=0
