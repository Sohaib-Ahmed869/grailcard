{
  "name": "grailcard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:vision": "node scripts/venv-python.mjs -m uvicorn app.main:app --app-dir services/vision --port 8100 --reload",
    "build": "npm run build --workspaces --if-present",
    "test:vision": "node scripts/venv-python.mjs --cwd services/vision -m pytest tests -q"
  }
}
